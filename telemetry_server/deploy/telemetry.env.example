# Copy to /etc/bet-telemetry/telemetry.env; keep it outside the web root.
# Owner root:bet-telemetry, permissions 0640. Never ship this file to clients.
BET_TELEMETRY_DB=/var/lib/bet-telemetry/telemetry.sqlite3

# Set both values yourself. Blank values do not enable an admin account.
# Generate a password with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BET_TELEMETRY_ADMIN_USER=
BET_TELEMETRY_ADMIN_PASSWORD=

# Use 1 ONLY with the supplied single-hop Nginx configuration and loopback bind.
# The application accepts forwarded IPs only from exact 127.0.0.1 or ::1 peers.
BET_TELEMETRY_TRUST_PROXY=1
