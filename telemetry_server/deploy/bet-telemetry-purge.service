[Unit]
Description=Expire BET telemetry events, IP observations, and redacted backups
After=bet-telemetry.service

[Service]
Type=oneshot
User=bet-telemetry
Group=bet-telemetry
WorkingDirectory=/opt/bet-telemetry/app
EnvironmentFile=/etc/bet-telemetry/telemetry.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
ExecStart=/opt/bet-telemetry/venv/bin/python -m telemetry_server purge
# Expire backup copies even if database cleanup/checkpoint fails.
ExecStopPost=/opt/bet-telemetry/venv/bin/python telemetry_server/deploy/backup_redacted.py prune --directory /var/backups/bet-telemetry
UMask=0077
StateDirectory=bet-telemetry
StateDirectoryMode=0700
ReadWritePaths=-/var/backups/bet-telemetry
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
